# direnv: one `direnv allow` and the toolchain is on PATH for this repo.
# Requires uv (https://docs.astral.sh/uv/). Everything else is pinned in uv.lock.

export UV_PROJECT_ENVIRONMENT=.venv

# Sync the environment (dev group + every extra) on entry.
uv sync --all-extras >/dev/null

PATH_add .venv/bin

# src-layout: make the package importable without an editable install for the
# bench/ and scripts/ entry points that run files directly.
export PYTHONPATH="$PWD/src"
